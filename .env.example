# Safe, non-secret application settings
APP_ENV=development
INTERVIEW_DURATION_MINUTES=15

# Groq receives the interview documents and conversation text.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: set only after approving additional evaluation calls.
GROQ_JUDGE_MODEL=
# Post-interview scorecard, using the same approved Groq key.
GROQ_EVALUATOR_MODEL=openai/gpt-oss-120b

# Deepgram receives microphone audio for transcription and interviewer reply
# text for speech synthesis. It does not receive resume or job-description text.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3-general
DEEPGRAM_TTS_VOICE=aura-2-helena-en

# Local development uses SmallWebRTC and SQLite. Render overrides the transport
# to Daily and supplies DATABASE_URL from its secret settings.
VOICE_TRANSPORT=webrtc
SQLITE_PATH=data/interviewflow.db
DATABASE_URL=
DAILY_API_KEY=

# Comma-separated browser origins allowed to call the Pipecat runner.
PIPECAT_ALLOWED_ORIGINS=http://localhost:5173
